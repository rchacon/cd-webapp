# Only VITE_COGNITO_CLIENT_ID and VITE_COGNITO_DOMAIN are read by src/auth/config.ts
# today. VITE_AWS_REGION and VITE_COGNITO_USER_POOL_ID are kept here for parity with
# the Amplify app's env vars (see cd-infra's terraform/cd-webapp/main.tf) in case
# future code needs them -- not currently used by anything in this repo.
VITE_AWS_REGION=us-west-2
VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=auth.example.com
